scripts/setup-gcs-cors.sh
deploy.cmd

# Local config
.env
.env.*
.gitignore
.dockerignore
cloudbuild.yaml

# Local runtime data (gitignored; must never upload to the build -
# sessions/exports/logs can contain user data and sit under the docroot)
sessions/
logs/
exports/
uploads/*
!uploads/.htaccess
!uploads/logos/

# Windows reserved-name artifact created by local test proc_open sinks
NUL
