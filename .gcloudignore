vendor/**
.git/**
node_modules/**

# Test files and artifacts
tests/**
testResults/**
*.spec.ts
*.spec.js
*.test.ts
*.test.js
playwright.config.ts
playwright-report/**
test-results/**

# Development tooling
package.json
package-lock.json
tsconfig.json
*.md
README.md
.env.example
scripts/**
# cloudbuild.yaml's final step runs this provisioning script inside the
# build workspace, so it must survive the source upload.
!scripts/provision-integration-worker.sh
deploy.cmd

# Local config
.env
.env.*
.gitignore
.dockerignore
cloudbuild.yaml

# Local runtime data (gitignored; must never upload to the build -
# sessions/exports/logs can contain user data and sit under the docroot)
sessions/
logs/
exports/
uploads/*
!uploads/.htaccess
!uploads/logos/
