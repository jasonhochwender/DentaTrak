# ===========================================
# DentaTrak Environment Configuration
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ===========================================

# Encryption key for sensitive data (generate a random 64-character hex string)
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Local Development Database credentials (MAMP)
DB_USER_LOCAL=root
DB_PASSWORD_LOCAL=root

# UAT/Production Database credentials
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=dental_case_tracker

# ===========================================
# GOOGLE API CREDENTIALS
# ===========================================
# Get these from Google Cloud Console: https://console.cloud.google.com/

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_API_KEY=your_google_api_key

# ===========================================
# AI PROVIDER CONFIGURATION
# ===========================================

# AI Provider: 'openai' or 'gemini'
AI_PROVIDER=gemini

# OpenAI API credentials (if using OpenAI)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Gemini API credentials (if using Gemini)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# EMAIL CONFIGURATION (Resend)
# ===========================================
# Get from: https://resend.com/api-keys

RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=DentaTrak

# ===========================================
# GOOGLE CLOUD STORAGE (File Uploads)
# ===========================================
# Bucket name for case file uploads (STL scans, photos, etc.)
# REQUIRED — the app will fail loudly if this is not set when file uploads are used.
# Production: dtk-prod-case-files
GCS_BUCKET_NAME=dtk-prod-case-files
# Service account key file path (local dev only - Cloud Run uses ADC)
# GCS_KEY_FILE=/path/to/service-account-key.json
# Secret key for orphan upload cleanup endpoint (set a random string)
CLEANUP_SECRET_KEY=your_random_cleanup_secret_here

# ===========================================
# STRIPE BILLING CONFIGURATION
# ===========================================
#
# STRIPE_ENVIRONMENT controls which Stripe account is active.
# The application enforces that keys match the declared environment:
#   test  → STRIPE_SECRET_KEY must start with sk_test_
#           STRIPE_PUBLISHABLE_KEY must start with pk_test_
#   live  → STRIPE_SECRET_KEY must start with sk_live_
#           STRIPE_PUBLISHABLE_KEY must start with pk_live_
#
# There is NO silent cross-environment fallback. A misconfigured key
# will cause a logged config_error and a 500 response, not a live charge.
#
# Local development:  STRIPE_ENVIRONMENT=test
# Production:         STRIPE_ENVIRONMENT=live
#
# NEVER commit sk_test_... sk_live_... or whsec_... values to source control.

# Master billing feature flag.
# false (default) = billing UI, endpoints, subscription restrictions, and Stripe
#                   env vars are all completely inactive. Safe for production while
#                   Stripe is not yet fully configured.
# true            = billing fully active. Requires all STRIPE_* vars below.
# Local dev:   BILLING_ENABLED=true
# Production:  BILLING_ENABLED=false  (omit or set explicitly)
BILLING_ENABLED=false

STRIPE_ENVIRONMENT=test

# API keys — get from https://dashboard.stripe.com/apikeys
# Test mode:  use the "Standard keys" shown when "Test mode" toggle is ON
# Live mode:  use the "Standard keys" shown when "Test mode" toggle is OFF
STRIPE_SECRET_KEY=sk_test_YOUR_SANDBOX_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_SANDBOX_PUBLISHABLE_KEY

# Webhook signing secret
# Local dev:   run  stripe listen --forward-to http://localhost/DentaTrak/api/stripe-webhook.php
#              then copy the  whsec_...  printed by the CLI
# Production:  copy from Stripe Dashboard -> Developers -> Webhooks -> [endpoint] -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET

# Optional test-mode webhook signing secret. Stripe test and live webhooks use
# different secrets. If you send test events to the same endpoint, set this so
# the endpoint can verify both production and test signatures.
# STRIPE_WEBHOOK_SECRET_TEST=whsec_YOUR_TEST_WEBHOOK_SIGNING_SECRET

# Price IDs — one per plan/interval combination.
# Local dev:   create sandbox (test-mode) prices and paste those price_... IDs here.
# Production:  set to the live price_... IDs via Cloud Run environment variables.
# NEVER put live price IDs in this file.
#
# These are the ONLY source of the Stripe Price ID -> plan mapping
# (see api/stripe-price-map.php). A plan with no Price ID configured for the
# running environment cannot be purchased there: checkout fails closed with a
# controlled error and never falls back to another environment's IDs.
STRIPE_OPERATE_MONTHLY_PRICE_ID=price_YOUR_SANDBOX_OPERATE_MONTHLY
STRIPE_OPERATE_ANNUAL_PRICE_ID=price_YOUR_SANDBOX_OPERATE_ANNUAL
STRIPE_CONTROL_MONTHLY_PRICE_ID=price_YOUR_SANDBOX_CONTROL_MONTHLY
STRIPE_CONTROL_ANNUAL_PRICE_ID=price_YOUR_SANDBOX_CONTROL_ANNUAL

# Scale ($999/mo, $9,990/yr — up to 50 owned practices).
# Test/sandbox Price IDs exist today; LIVE Scale prices have NOT been created
# yet. To enable Scale in production, create the two live prices in the live
# Stripe account and set these same two variable names as Cloud Run
# environment variables — no application code changes are required.
# Leave them unset until then: Scale checkout in production will return a
# controlled "not available" error rather than using a test Price ID.
STRIPE_SCALE_MONTHLY_PRICE_ID=price_YOUR_SANDBOX_SCALE_MONTHLY
STRIPE_SCALE_ANNUAL_PRICE_ID=price_YOUR_SANDBOX_SCALE_ANNUAL

# Scale additional-practice add-on ($99/mo or $990/yr per extra practice
# beyond the five included in the base Scale price). Configured per environment.
STRIPE_SCALE_ADDITIONAL_MONTHLY_PRICE_ID=price_YOUR_SANDBOX_SCALE_ADDITIONAL_MONTHLY
STRIPE_SCALE_ADDITIONAL_ANNUAL_PRICE_ID=price_YOUR_SANDBOX_SCALE_ADDITIONAL_ANNUAL

# Customer Portal configuration ID (bpc_...)
# Local dev:   create a test-mode portal configuration and paste its bpc_... ID here.
# Production:  set via Cloud Run environment variable.
# If left empty the portal opens with the Stripe default configuration.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_YOUR_SANDBOX_PORTAL_CONFIG_ID

# Base URL for Stripe success/cancel redirects and portal return URL.
# Local dev:   http://localhost/DentaTrak
# Production:  https://dentatrak.com
APP_BASE_URL=http://localhost/DentaTrak

# Dev-only fault injection — forces webhook to return HTTP 500 so you can
# test the retry path without renaming or dropping tables.
# Set to 1 to trigger, remove or set to 0 to disable.
# THIS FLAG HAS NO EFFECT IN PRODUCTION (IS_CLOUD_RUN=true disables it).
# STRIPE_WEBHOOK_FORCE_FAILURE=1

# ===========================================
# DEV TOOLS CONFIGURATION
# ===========================================

# Set to 'true' to enable dev tools for super users in UAT/Production
DEV_TOOLS_ENABLED=false

# Comma-separated list of super user emails who can access dev tools
SUPER_USERS=admin@yourdomain.com

# ===========================================
# SUPPORT / USER GUIDE
# ===========================================

# Public support email address (defaults to support@dentatrak.com if unset)
SUPPORT_EMAIL=support@dentatrak.com

# IndexNow search engine notification key
# Generate a 32-character hex key, create the verification file at /{INDEXNOW_KEY}.txt,
# and set INDEXNOW_HOST to the production domain.
INDEXNOW_KEY=your_32_character_indexnow_key_here
INDEXNOW_HOST=https://dentatrak.com

# Test-only flag: when true, emails are recorded to disk instead of sent via Resend.
# Set this to true for E2E / Playwright test environments.
DENTATRAK_TEST_RECORD_EMAILS=true
