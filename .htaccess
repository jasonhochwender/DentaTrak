# Custom 404 Error Page
ErrorDocument 404 /404.php

# Expose Authorization header to PHP for the queue worker and other APIs.
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} ^(.*)$
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1,NE]
</IfModule>

# Clean URLs - rewrite /page to /page.php (production only)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect direct /index.php requests to canonical root (avoids duplicate without user-selected canonical)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /[^?]*index\.php
  RewriteRule ^index\.php$ / [R=301,L]

  # User Guide: clean public URL and prevent direct PDF indexing by forcing
  # all User Guide requests through the streaming endpoint that sets headers.
  RewriteRule ^resources/user-guide$ api/user-guide.php [L]
  RewriteCond %{REQUEST_URI} ".*resource-assets/DentaTrak(%20| )User(%20| )Guide\.pdf$" [NC]
  RewriteRule .* api/user-guide.php [L]

  # Canonical redirect for trailing slash on /resources/ to /resources
  RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} ^([^:]+)
  RewriteRule ^resources/$ https://%1/resources [L,R=301]

  # Resources landing page: served by resources.php.
  RewriteRule ^resources/?$ resources.php [L]
  
  # Skip if the request is a real file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Rewrite clean URL to .php file (e.g., /dental-case-tracking -> dental-case-tracking.php)
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-zA-Z0-9-]+)/?$ $1.php [L]
</IfModule>

# Force HTTPS redirect
# NOTE: On Google App Engine, SSL is terminated at the load balancer
# so %{HTTPS} may always appear "off". Use X-Forwarded-Proto header instead.
# Skip redirect for localhost/development environments.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Skip HTTPS redirect for localhost/development
  RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
  # Check both HTTPS flag and X-Forwarded-Proto header (for load balancers)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # Capture the host without any container port (Cloud Run may expose :8080 in HTTP_HOST)
  RewriteCond %{HTTP_HOST} ^([^:]+)
  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Suppress PHP deprecation warnings
php_flag display_errors off
php_value error_reporting 22519

# Essential MIME types for JavaScript files
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/javascript .js
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  
  # CSS files - 1 year (use versioned URLs like ?v=20241227)
  ExpiresByType text/css "access plus 1 year"
  
  # JavaScript files - 1 year (use versioned URLs)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Images - 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fonts - 1 year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  # CSS and JS files - 1 year with immutable for versioned assets
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Images - 1 year
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Fonts - 1 year
  <FilesMatch "\.(woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
