# ===========================================
# DentaTrak .gitignore
# ===========================================

# ===========================================
# SENSITIVE FILES - NEVER COMMIT THESE
# ===========================================

# Environment variables (contains API keys, passwords, secrets)
.env
.env.*
!.env.example

# Environment mode override file
.env_mode

# ===========================================
# DEPENDENCIES
# ===========================================

# Composer dependencies (reinstall via composer install)
/vendor/

# ===========================================
# LOGS & CACHE & SESSIONS
# ===========================================

# Log files
/logs/
*.log

# Session files
/sessions/

# Practice-wide data export files (api/data-export.php writes these -
# contains exported case/PHI-adjacent data, never commit)
/exports/

# PHP cache
*.cache

# ===========================================
# UPLOADS & USER DATA
# ===========================================

# All uploaded files (case attachments, logos, etc.)
/uploads/

# Documentation folder (flyers, marketing materials)
/documentation/

# ===========================================
# IDE & EDITOR FILES
# ===========================================

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains IDEs (PhpStorm, WebStorm, etc.)
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ===========================================
# OPERATING SYSTEM FILES
# ===========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ===========================================
# BUILD & DEPLOYMENT
# ===========================================

# Node modules (if any frontend build tools are added)
node_modules/

# Deployment artifacts
*.tar.gz
*.zip

# ===========================================
# TESTING (Playwright E2E)
# ===========================================

# Test files - NEVER deploy to production
/tests/*
!/tests/download-zip-streaming-test.php
!/tests/download-zip-memory-test.php
!/tests/download-zip-headers-test.php
!/tests/session-timeout-test.php
!/tests/session-timeout-js-test.js
!/tests/session-db-handler-test.php
!/tests/session-security-concurrency-test.php
!/tests/session-concurrency-test.php
!/tests/session-lock-timeout-test.php
!/tests/session-download-lock-test.php
!/tests/case-type-bite-rim-test.php
!/tests/workflow-columns-test.php
!/tests/workflow-columns-api-test.php
!/tests/workflow-archive-sql-test.php
!/tests/workflow-practice-context-test.php
!/tests/workflow-columns-side-effects-test.php
!/tests/workflow-remove-isolation-test.php
!/tests/workflow-restore-test.php
!/tests/workflow-restore-dom-test.php
!/tests/workflow-reset-defaults-test.php
!/tests/workflow-reset-sql-test.php
!/tests/workflow-init-runtime-test.php
!/tests/insights-loader-test.php
!/tests/billing-header-visibility-test.php
!/tests/billing-flash-render-test.php
!/tests/analytics-api-test.php
!/tests/admin-practices-auth-test.php
!/tests/admin-practices-csrf-and-auth-test.php
!/tests/admin-practices-subscription-test.php
!/tests/admin-practices-extend-trial-integration-test.php
/testResults/
/test-results/
/playwright-report/

# Playwright configuration
playwright.config.ts
playwright.config.js

# Test-only Node dependencies
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===========================================
# MISCELLANEOUS
# ===========================================

# Temporary files
*.tmp
*.temp
*.bak

# PHP error files
php_errors.log
error_log
documentation/Google Cloud Setup.docx
